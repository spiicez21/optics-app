rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User profile images — only the owning user can write
    match /profile_images/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024;
    }

    // Admin-uploaded images (product & category images from the React dashboard)
    // Any authenticated user may read; any authenticated user may write (lock down
    // further with custom claims once you add admin roles).
    match /admin/{allPaths=**} {
      allow read:  if true;                        // public — needed for app to display images
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
