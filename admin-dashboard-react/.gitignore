# ============================================================
#  OpticShop Admin React — .gitignore
# ============================================================

# ── Secrets ─────────────────────────────────────────────────
# Real Firebase keys — NEVER commit
.env
.env.local
.env.*.local

# Keep example templates in git
!.env.example
!.env.*.example

# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Build output ─────────────────────────────────────────────
dist/
dist-ssr/

# ── Vite cache ───────────────────────────────────────────────
.vite/

# ── Logs ─────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ───────────────────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
